DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
APP_NAME=NDIS Lead Finder
APP_TIME_ZONE=Australia/Melbourne

# SQLite MVP. Use an absolute path on cPanel where possible.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/home/CPANEL_USER/ndis-lead-finder/db.sqlite3
SQLITE_TIMEOUT=20

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=NDIS Lead Finder <noreply@example.com>

DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

SCRAPER_USER_AGENT=NDISLeadFinder/1.0 (+https://example.com/scraper-policy; contact=admin@example.com)
SCRAPER_TIMEOUT_SECONDS=25
SELENIUM_ENABLED=false


BRAVE_API_KEY=

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_MIN_RELEVANCE=60

# Groq: https://console.groq.com/keys (replaces Gemini for scoring and AI search when set)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

BACKUP_DIR=/home/CPANEL_USER/ndis-lead-finder/backups
BACKUP_RETENTION_DAYS=14


FIELD_ENCRYPTION_KEY=

# Optional. With Redis installed, set this and run the Celery worker (see DEPLOYMENT_HOSTINGER.md).
# Leave empty on shared hosting: cron runs the jobs instead.
REDIS_URL=
